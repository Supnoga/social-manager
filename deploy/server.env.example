# Skopíruj ako deploy/server.env a doplň na serveri. Tento súbor NIKDY nedávaj do gitu (repozitár je verejný).
ANTHROPIC_API_KEY=
# kľúč do schvaľovacej schránky N2N OS (oprávnenie inbox:write); bez neho sa zdroje schvaľujú v appke
OS_INBOX_KEY=
# krajiny pre redakciu a projekty (čísla oddelené medzerou), ktoré redakcia spracúva
SM_COUNTRIES=CZ,AT,PL,HU
SM_PROJECTS=1
# 1 = nasucho: nič sa nepublikuje ani neodosiela. Zmeniť na 0 len po Oliverovom súhlase.
SM_DRY_RUN=1
